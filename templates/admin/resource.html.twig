{% extends '@Atrium/admin/layout.html.twig' %}

{% block title %}{{ heading }} · {{ panel.brand }}{% endblock %}
{% block heading %}{{ heading }}{% endblock %}
{% block subheading %}{% if subheading %}<p class="mt-0.5 truncate text-sm text-gray-500 dark:text-gray-400">{{ subheading }}</p>{% endif %}{% endblock %}

{# Header actions (the "New" button, custom create/import actions) render inside
   the DataTable Live Component so server-driven actions work — see headerActions(). #}

{% block body %}
    <div class="rounded-2xl border border-gray-200/80 bg-white p-4 shadow-sm sm:p-5 dark:border-gray-800/80 dark:bg-gray-900">
        <twig:Atrium:DataTable :resource="resource.slug" :pathPrefix="panel.pathPrefix" />
    </div>
{% endblock %}
