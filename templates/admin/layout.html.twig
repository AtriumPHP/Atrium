<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ panel.brand }}{% endblock %}</title>
    {% block stylesheets %}
        {{ atrium_stylesheet() }}
    {% endblock %}
    {% block javascripts %}
        {{ atrium_importmap('app') }}
    {% endblock %}
</head>
<body class="h-full bg-gray-50 text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100">
<div class="flex min-h-full">
    {# ---------------------------------------------------------------- Sidebar #}
    <aside class="sticky top-0 hidden h-screen w-64 shrink-0 flex-col border-r border-gray-200/80 bg-white/70 backdrop-blur-xl md:flex dark:border-gray-800/80 dark:bg-gray-900/60">
        <div class="flex h-16 items-center px-5">
            <a href="{{ panel.pathPrefix }}" class="flex items-center gap-2.5">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary-400 to-primary-600 text-sm font-bold text-white shadow-sm shadow-primary-600/30">
                    {{ panel.brand|first|upper }}
                </span>
                <span class="text-base font-semibold tracking-tight">{{ panel.brand }}</span>
            </a>
        </div>

        <nav class="flex-1 space-y-0.5 overflow-y-auto px-3 py-3 text-sm">
            {% set navBadgeClasses = {
                gray:    'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300',
                primary: 'bg-primary-100 text-primary-700 dark:bg-primary-900 dark:text-primary-200',
                red:     'bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300',
                green:   'bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300',
                amber:   'bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300',
                sky:     'bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300',
            } %}
            {# Dashboards and resources are separate groups, divided by a rule. #}
            {% set navGroups = [
                { label: null, items: panel.dashboards },
                { label: 'Resources', items: panel.resources },
            ]|filter(group => group.items is not empty) %}
            {% for group in navGroups %}
                {% if not loop.first %}
                    <div class="mx-3 my-3 border-t border-gray-200/70 dark:border-gray-800/70"></div>
                {% endif %}
                {% if group.label %}
                    <p class="px-3 pb-1 text-[0.65rem] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">{{ group.label }}</p>
                {% endif %}
                {% for item in group.items %}
                    <a href="{{ item.url }}"
                       class="group flex items-center gap-3 rounded-lg px-3 py-2 font-medium transition-colors {{ item.active
                           ? 'bg-primary-600 text-white shadow-sm shadow-primary-600/30'
                           : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800/70 dark:hover:text-white' }}">
                        {{ atrium_icon(item.icon ?? 'squares', { class: 'h-5 w-5 shrink-0' }) }}
                        <span class="flex-1 truncate">{{ item.label }}</span>
                        {% if item.badge is not null and item.badge != '' %}
                            <span class="ml-auto inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ item.active
                                ? 'bg-white/20 text-white'
                                : (navBadgeClasses[item.badgeColor] ?? navBadgeClasses.primary) }}">{{ item.badge }}</span>
                        {% endif %}
                    </a>
                {% endfor %}
            {% endfor %}
        </nav>

        <div class="border-t border-gray-200/80 px-5 py-3 text-xs text-gray-400 dark:border-gray-800/80 dark:text-gray-500">
            Powered by {{ panel.brand }}
        </div>
    </aside>

    {# ------------------------------------------------------------------- Main #}
    <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-10 flex min-h-16 items-center justify-between gap-4 border-b border-gray-200/80 bg-gray-50/80 px-5 py-2.5 backdrop-blur-xl sm:px-8 dark:border-gray-800/80 dark:bg-gray-950/70">
            <div class="min-w-0">
                <h1 class="truncate text-lg font-semibold tracking-tight">{% block heading %}{% endblock %}</h1>
                {% block subheading %}{% endblock %}
            </div>
            <div class="flex items-center gap-3">{% block header_actions %}{% endblock %}</div>
        </header>
        <main class="flex-1 p-5 sm:p-8">
            <div class="mx-auto max-w-screen-2xl">
                {% block body %}{% endblock %}
            </div>
        </main>
    </div>
</div>
</body>
</html>
