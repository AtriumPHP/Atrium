{% extends '@Atrium/admin/layout.html.twig' %}

{% block title %}{{ heading }} · {{ panel.brand }}{% endblock %}
{% block heading %}{{ heading }}{% endblock %}
{% block subheading %}{% if subheading %}<p class="mt-0.5 truncate text-sm text-gray-500 dark:text-gray-400">{{ subheading }}</p>{% endif %}{% endblock %}

{% block header_actions %}
    <a href="{{ panel.pathPrefix }}/{{ resource.slug }}"
       class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 hover:text-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white">
        {{ atrium_icon('arrow-left', { class: 'h-4 w-4' }) }}
        {{ resource.label }}
    </a>
    {% if record %}
        {# The page's header actions (Edit link, Delete + custom server actions) are
           hosted by a small Live Component so they run through the shared action
           plumbing even though the View screen is a static render. Its confirmation
           modal escapes the header because the layout keeps `backdrop-filter` off
           the header element itself (see admin/layout.html.twig). #}
        {{ component('Atrium:RecordActions', {
            resource: resource.slug,
            entityId: entityId,
            pathPrefix: panel.pathPrefix,
        }) }}
    {% endif %}
{% endblock %}

{% block body %}
    <div class="mx-auto max-w-4xl space-y-6">
        {% if record %}
            {% set headerComponents = headerWidgets.getComponents() %}
            {% if headerComponents is not empty %}
                {# Record-scoped widget band above the entries (the slots carry the
                   record id in context). #}
                {{ include('@Atrium/components/layout/components.html.twig', {
                    components: headerComponents,
                    gridClass: 'grid-cols-1',
                }) }}
            {% endif %}

            {{ include('@Atrium/components/layout/components.html.twig', {
                components: schema.getComponents(),
                record: record,
            }) }}

            {% set footerComponents = footerWidgets.getComponents() %}
            {% if footerComponents is not empty %}
                {{ include('@Atrium/components/layout/components.html.twig', {
                    components: footerComponents,
                    gridClass: 'grid-cols-1',
                }) }}
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
