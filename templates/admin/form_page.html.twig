{% extends '@Atrium/admin/layout.html.twig' %}

{% block title %}{{ heading }} · {{ panel.brand }}{% endblock %}
{% block heading %}{{ heading }}{% endblock %}

{% block header_actions %}
    <a href="{{ panel.pathPrefix }}/{{ resource.slug }}"
       class="text-sm font-medium text-gray-500 hover:text-gray-900 dark:hover:text-white">← Back to {{ resource.label }}</a>
{% endblock %}

{% block body %}
    <div class="max-w-2xl rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
        <twig:Atrium:Form
            :resource="resource.slug"
            :entityId="entityId"
            :redirectAfterSave="redirectUrl"
        />
    </div>
{% endblock %}
