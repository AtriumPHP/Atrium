{# Stats overview widget (WGT-09): a responsive grid of stat cards.
   `widget` is the resolved StatsWidget descriptor. #}
{%- set statColors = {
    primary: 'text-primary-600 dark:text-primary-400',
    gray:    'text-gray-600 dark:text-gray-400',
    green:   'text-green-600 dark:text-green-400',
    success: 'text-green-600 dark:text-green-400',
    red:     'text-red-600 dark:text-red-400',
    danger:  'text-red-600 dark:text-red-400',
    amber:   'text-amber-600 dark:text-amber-400',
    warning: 'text-amber-600 dark:text-amber-400',
    sky:     'text-sky-600 dark:text-sky-400',
    info:    'text-sky-600 dark:text-sky-400',
} -%}
{# Use explicit getX() accessors: the fluent setters (description(), color(),
   url(), …) share their property names, so `stat.description` would resolve to
   the setter. #}
<div class="grid gap-4 {{ widget.innerGridClass }}">
    {% for stat in widget.stats %}
        {%- set color = stat.getColor() -%}
        {%- set card -%}
            <div class="relative h-full rounded-2xl border border-gray-200/80 bg-white p-5 shadow-sm dark:border-gray-800/80 dark:bg-gray-900">
                <p class="text-sm font-medium text-gray-500 dark:text-gray-400">{{ stat.getLabel() }}</p>
                <p class="mt-1 text-2xl font-semibold tracking-tight text-gray-900 dark:text-gray-100">{{ stat.getValue() }}</p>
                {% if stat.getDescription() %}
                    <p class="mt-1 flex items-center gap-1 text-sm {{ statColors[color] ?? statColors.gray }}">
                        {% if stat.getDescriptionIcon() %}{{ include('@Atrium/icon.html.twig', { name: stat.getDescriptionIcon(), class: 'h-4 w-4 shrink-0' }) }}{% endif %}
                        <span>{{ stat.getDescription() }}</span>
                    </p>
                {% endif %}
            </div>
        {%- endset -%}
        {% if stat.getUrl() %}
            <a href="{{ stat.getUrl() }}" class="block transition-transform hover:-translate-y-0.5">{{ card }}</a>
        {% else %}
            {{ card }}
        {% endif %}
    {% endfor %}
</div>
