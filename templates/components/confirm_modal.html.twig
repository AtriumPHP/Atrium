{#
    Server-driven confirmation dialog — a re-rendered prompt, no client JS.
    Shared by the record-action and bulk-action flows. Params:
      - title         : heading and confirm-button label
      - message       : explanatory body text
      - color         : semantic colour key for the confirm button
      - confirmAction : Live action run on confirm
      - cancelAction  : Live action run on dismiss
#}
{% set confirmColors = {
    gray:    'bg-gray-600 hover:bg-gray-500 focus:ring-gray-500',
    primary: 'bg-primary-600 hover:bg-primary-500 focus:ring-primary-500',
    red:     'bg-red-600 hover:bg-red-500 focus:ring-red-500',
    green:   'bg-green-600 hover:bg-green-500 focus:ring-green-500',
    amber:   'bg-amber-500 hover:bg-amber-400 focus:ring-amber-500',
    sky:     'bg-sky-600 hover:bg-sky-500 focus:ring-sky-500',
} %}
<div class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <button type="button" aria-label="Dismiss"
            data-action="live#action" data-live-action-param="{{ cancelAction }}"
            class="absolute inset-0 cursor-default bg-gray-900/50 backdrop-blur-sm"></button>
    <div role="alertdialog" aria-modal="true" aria-labelledby="atrium-confirm-title" class="relative w-full max-w-md rounded-2xl border border-gray-200 bg-white p-6 shadow-xl dark:border-gray-800 dark:bg-gray-900">
        <h2 id="atrium-confirm-title" class="text-base font-semibold text-gray-900 dark:text-gray-100">{{ title }}</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{{ message }}</p>
        <div class="mt-5 flex justify-end gap-3">
            <button type="button"
                    data-action="live#action" data-live-action-param="{{ cancelAction }}"
                    class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 hover:text-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white">
                Cancel
            </button>
            <button type="button"
                    data-action="live#action" data-live-action-param="{{ confirmAction }}"
                    class="rounded-lg px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-gray-900 {{ confirmColors[color]|default(confirmColors.primary) }}">
                {{ title }}
            </button>
        </div>
    </div>
</div>
