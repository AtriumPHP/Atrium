<div {{ attributes }} class="atrium-relation-manager space-y-3">
    {% if this.canCreateRelated or this.canAssociateRelated or this.canAttachRelated or this.getNestedCreateUrl %}
        <div class="flex justify-end gap-2">
            {% if this.canAssociateRelated %}
                <button type="button" data-action="live#action" data-live-action-param="openAssociate"
                        class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">
                    {{ atrium_icon('link', { class: 'h-4 w-4' }) }} Attach existing
                </button>
            {% endif %}
            {% if this.canAttachRelated %}
                <button type="button" data-action="live#action" data-live-action-param="openAttach"
                        class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">
                    {{ atrium_icon('link', { class: 'h-4 w-4' }) }} Attach existing
                </button>
            {% endif %}
            {% if this.getNestedCreateUrl %}
                {# Nested target: New links to the child's full nested create page. #}
                <a href="{{ this.getNestedCreateUrl }}"
                   class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950">
                    {{ atrium_icon('plus', { class: 'h-4 w-4' }) }} New {{ this.singularLabel }}
                </a>
            {% elseif this.canCreateRelated %}
                <button type="button" data-action="live#action" data-live-action-param="openCreate"
                        class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950">
                    {{ atrium_icon('plus', { class: 'h-4 w-4' }) }} New {{ this.singularLabel }}
                </button>
            {% endif %}
        </div>
    {% endif %}

    {% include '@Atrium/components/_record_table.html.twig' %}

    {% if this.isModalOpen and this.modalMode in ['create', 'edit'] %}
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <button type="button" data-action="live#action" data-live-action-param="closeModal"
                    aria-label="Close" class="absolute inset-0 cursor-default bg-gray-900/50 backdrop-blur-sm"></button>
            <div role="dialog" aria-modal="true" aria-labelledby="atrium-relation-form-title"
                 class="relative z-10 w-full max-w-lg rounded-2xl border border-gray-200 bg-white p-6 shadow-xl dark:border-gray-800 dark:bg-gray-900">
                <h2 id="atrium-relation-form-title" class="mb-4 text-lg font-semibold text-gray-900 dark:text-gray-100">
                    {{ this.modalMode == 'create' ? 'New ' : 'Edit ' }}{{ this.singularLabel }}
                </h2>
                {{ component('Atrium:Form', this.getModalFormProps) }}
            </div>
        </div>
    {% endif %}

    {% if this.isModalOpen and this.modalMode == 'associate' %}
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <button type="button" data-action="live#action" data-live-action-param="closeModal"
                    aria-label="Close" class="absolute inset-0 cursor-default bg-gray-900/50 backdrop-blur-sm"></button>
            <div role="dialog" aria-modal="true" aria-labelledby="atrium-relation-associate-title"
                 class="relative z-10 w-full max-w-md rounded-2xl border border-gray-200 bg-white p-6 shadow-xl dark:border-gray-800 dark:bg-gray-900">
                <h2 id="atrium-relation-associate-title" class="mb-4 text-lg font-semibold text-gray-900 dark:text-gray-100">Attach existing {{ this.singularLabel }}</h2>
                <select data-model="associateId"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
                    <option value="">—</option>
                    {% for value, label in this.getLinkableOptions %}
                        <option value="{{ value }}">{{ label }}</option>
                    {% endfor %}
                </select>
                <div class="mt-4 flex justify-end gap-2">
                    <button type="button" data-action="live#action" data-live-action-param="closeModal"
                            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">
                        Cancel
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="submitAssociate"
                            class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950">
                        Attach
                    </button>
                </div>
            </div>
        </div>
    {% endif %}

    {% if this.isModalOpen and this.modalMode == 'attach' %}
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
            <button type="button" data-action="live#action" data-live-action-param="closeModal"
                    aria-label="Close" class="absolute inset-0 cursor-default bg-gray-900/50 backdrop-blur-sm"></button>
            <div role="dialog" aria-modal="true" aria-labelledby="atrium-relation-attach-title"
                 class="relative z-10 w-full max-w-md rounded-2xl border border-gray-200 bg-white p-6 shadow-xl dark:border-gray-800 dark:bg-gray-900">
                <h2 id="atrium-relation-attach-title" class="mb-4 text-lg font-semibold text-gray-900 dark:text-gray-100">Attach existing {{ this.singularLabel }}</h2>
                <select data-model="attachId"
                        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
                    <option value="">—</option>
                    {% for value, label in this.getLinkableOptions %}
                        <option value="{{ value }}">{{ label }}</option>
                    {% endfor %}
                </select>
                {% for column in this.getPivotColumns %}
                    <label class="mt-3 block text-sm font-medium text-gray-700 dark:text-gray-200">{{ column }}
                        <input type="text" data-model="pivotData[{{ column }}]"
                               class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
                    </label>
                {% endfor %}
                <div class="mt-4 flex justify-end gap-2">
                    <button type="button" data-action="live#action" data-live-action-param="closeModal"
                            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">
                        Cancel
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="submitAttach"
                            class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950">
                        Attach
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
</div>
