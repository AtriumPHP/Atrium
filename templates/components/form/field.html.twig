{#
    Field wrapper — the leaf node template every field renders through (it is what
    Field::getTemplate() returns). Computes the shared rendering context (name,
    error, live model binding, input classes) and delegates the actual input to
    the widget the field declares via getWidgetTemplate(). Custom field types ship
    their own widget from any bundle — no central if/elseif ladder.

    Receives `component` (the field) from the generic layout renderer.
#}
{% set field = component %}
{% set name = field.getName() %}
{% set error = this.getError(name) %}
{% set model = field.isLive() ? 'formData[' ~ name ~ ']' : 'norender|formData[' ~ name ~ ']' %}
{% set inputClass = 'mt-1 block w-full rounded-lg border px-3 py-2 text-sm shadow-sm transition-colors focus:outline-none focus:ring-1 dark:bg-gray-950 dark:text-gray-100 ' ~ (error
    ? 'border-red-400 focus:border-red-500 focus:ring-red-500 dark:border-red-500/70'
    : 'border-gray-300 focus:border-primary-500 focus:ring-primary-500 dark:border-gray-700') %}

<div>
    {% if not field.rendersOwnLabel() %}
        <label for="atrium_{{ name }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300{{ field.hasHiddenLabel() ? ' sr-only' }}">
            {{ field.getLabel() }}{% if field.isRequired() %} <span class="text-red-500">*</span>{% endif %}
        </label>
    {% endif %}

    {{ include(field.getWidgetTemplate(), {
        field: field, name: name, model: model, inputClass: inputClass,
    }) }}

    {% if field.getHelp() %}
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{ field.getHelp() }}</p>
    {% endif %}
    {% if error %}
        <p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ error }}</p>
    {% endif %}
</div>
