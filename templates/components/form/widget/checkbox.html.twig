<label class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
    <input type="checkbox" id="atrium_{{ name }}" data-model="{{ model }}"
           {{ this.getValue(name) ? 'checked' }} {{ field.isDisabled() ? 'disabled' }}
           class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-900">
    {{ field.getLabel() }}{% if field.isRequired() %} <span class="text-red-500">*</span>{% endif %}
</label>
