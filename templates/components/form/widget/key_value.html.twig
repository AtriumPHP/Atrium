<textarea id="atrium_{{ name }}" data-model="{{ model }}" rows="4"
          placeholder="{{ field.getPlaceholder() ?: 'key: value (one per line)' }}"
          {{ field.isDisabled() ? 'disabled' }} class="{{ inputClass }}">{{ this.getValue(name) }}</textarea>
{% set pairs = field.toPairs(this.getValue(name)) %}
{% if pairs %}
    <dl class="mt-2 divide-y divide-gray-100 rounded-md border border-gray-200 text-sm dark:divide-gray-800 dark:border-gray-800">
        {% for key, value in pairs %}
            <div class="flex gap-3 px-3 py-1.5">
                <dt class="font-medium text-gray-700 dark:text-gray-300">{{ key }}</dt>
                <dd class="text-gray-500 dark:text-gray-400">{{ value }}</dd>
            </div>
        {% endfor %}
    </dl>
{% endif %}
