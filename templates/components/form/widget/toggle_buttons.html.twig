<div class="mt-1 inline-flex overflow-hidden rounded-md border border-gray-300 dark:border-gray-700" role="group">
    {% for value, label in this.optionsFor(field) %}
        <label class="cursor-pointer border-l border-gray-300 first:border-l-0 dark:border-gray-700">
            <input type="radio" name="atrium_{{ name }}" value="{{ value }}" data-model="{{ model }}"
                   {{ this.getValue(name) == value ? 'checked' }} {{ field.isDisabled() ? 'disabled' }}
                   class="peer sr-only">
            <span class="inline-block px-3 py-1.5 text-sm text-gray-700 peer-checked:bg-primary-600 peer-checked:text-white dark:text-gray-300">{{ label }}</span>
        </label>
    {% endfor %}
</div>
