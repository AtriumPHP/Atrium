<div class="mt-1 flex items-center gap-3">
    <input type="color" id="atrium_{{ name }}" data-model="{{ model }}"
           value="{{ this.getValue(name) ?: '#000000' }}" {{ field.isDisabled() ? 'disabled' }}
           class="h-9 w-14 cursor-pointer rounded border border-gray-300 bg-white p-0.5 dark:border-gray-700 dark:bg-gray-900">
    <span class="text-sm text-gray-500 dark:text-gray-400">{{ this.getValue(name) ?: '#000000' }}</span>
</div>
