<textarea id="atrium_{{ name }}" data-model="{{ model }}" rows="{{ field.getRows() }}"
          {% if field.getPlaceholder() %}placeholder="{{ field.getPlaceholder() }}"{% endif %}
          {{ field.isAutofocused() ? 'autofocus' }} {{ field.isDisabled() ? 'disabled' }} class="{{ inputClass }}">{{ this.getValue(name) }}</textarea>
