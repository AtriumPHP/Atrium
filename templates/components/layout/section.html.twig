{#
    Section: a titled card grouping components in its own grid. Collapsible
    sections use a native <details>, so they need no JavaScript.
#}
{% set body %}
    {{ include('@Atrium/components/layout/components.html.twig', {
        components: component.getChildComponents(),
        gridClass: component.getGridClass(),
    }) }}
{% endset %}

{% set headerPad = component.isCompact() ? 'px-5 py-3' : 'px-6 py-4' %}
{% set bodyPad = component.isCompact() ? 'px-5 py-4' : 'px-6 py-5' %}
{% set hasHeader = component.getHeading() or component.getDescription() %}

{% set header %}
    <p class="text-sm font-semibold tracking-tight text-gray-900 dark:text-gray-100">{{ component.getHeading() }}</p>
    {% if component.getDescription() %}
        <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">{{ component.getDescription() }}</p>
    {% endif %}
{% endset %}

<section class="overflow-hidden rounded-2xl border border-gray-200/80 bg-white shadow-sm dark:border-gray-800/80 dark:bg-gray-900">
    {% if component.isCollapsible() %}
        <details{{ component.isCollapsed() ? '' : ' open' }} class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 {{ headerPad }}">
                <div class="min-w-0">{{ header }}</div>
                <span class="shrink-0 text-gray-400 transition-transform group-open:rotate-90 dark:text-gray-500">
                    {{ atrium_icon('chevron-right', { class: 'h-4 w-4' }) }}
                </span>
            </summary>
            <div class="border-t border-gray-100 {{ bodyPad }} dark:border-gray-800">{{ body }}</div>
        </details>
    {% else %}
        {% if hasHeader %}
            <header class="border-b border-gray-100 {{ headerPad }} dark:border-gray-800">{{ header }}</header>
        {% endif %}
        <div class="{{ bodyPad }}">{{ body }}</div>
    {% endif %}
</section>
