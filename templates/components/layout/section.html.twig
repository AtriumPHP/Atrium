{#
    Section: a titled, bordered card grouping components in its own grid.
    Collapsible sections use a native <details>, so they need no JavaScript.
#}
{% set body %}
    {{ include('@Atrium/components/layout/components.html.twig', {
        components: component.getChildComponents(),
        gridClass: component.getGridClass(),
    }) }}
{% endset %}

<section class="rounded-lg border border-gray-200 bg-white {{ component.isCompact() ? 'p-4' : 'p-6' }} dark:border-gray-800 dark:bg-gray-900">
    {% if component.isCollapsible() %}
        <details{{ component.isCollapsed() ? '' : ' open' }}>
            <summary class="cursor-pointer list-none text-base font-semibold text-gray-900 dark:text-gray-100">
                {{ component.getHeading() }}
            </summary>
            {% if component.getDescription() %}
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ component.getDescription() }}</p>
            {% endif %}
            <div class="mt-4">{{ body }}</div>
        </details>
    {% else %}
        {% if component.getHeading() %}
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">{{ component.getHeading() }}</h3>
        {% endif %}
        {% if component.getDescription() %}
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ component.getDescription() }}</p>
        {% endif %}
        <div class="{{ component.getHeading() or component.getDescription() ? 'mt-4' }}">{{ body }}</div>
    {% endif %}
</section>
