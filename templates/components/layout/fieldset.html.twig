{# Fieldset: labelled, optionally-bordered group (defaults to two columns). #}
<fieldset class="{{ component.isContained() ? 'rounded-lg border border-gray-200 p-4 dark:border-gray-800' }}">
    <legend class="px-1 text-sm font-medium text-gray-700 dark:text-gray-300">{{ component.getLabel() }}</legend>
    <div class="mt-2">
        {{ include('@Atrium/components/layout/components.html.twig', {
            components: component.getChildComponents(),
            gridClass: component.getGridClass(),
        }) }}
    </div>
</fieldset>
