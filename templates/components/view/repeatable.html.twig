{#
    Read-only repeatable entry: render the nested schema once per item, each item
    bound as the `record` for its entries. Re-enters the shared layout renderer so
    nested containers (and nested repeatables) compose. Everything comes from the
    single `v` descriptor (component.toView()); the outer `record` is resolved by
    the shared _field shell.
#}
{% embed '@Atrium/components/view/_field.html.twig' %}
    {% block value %}
        <div class="grid gap-4 {{ v.gridClass }}">
            {% for item in v.items %}
                <div class="{{ v.contained ? 'rounded-lg border border-gray-200 p-4 dark:border-gray-700' }}">
                    {{ include('@Atrium/components/layout/components.html.twig', {
                        components: v.schema,
                        record: item,
                        gridClass: v.columnsClass,
                    }) }}
                </div>
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
