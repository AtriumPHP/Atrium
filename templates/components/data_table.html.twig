<div {{ attributes }} class="atrium-datatable">
    <div class="mb-4 flex items-center gap-3">
        <div class="relative w-full max-w-sm">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                {{ include('@Atrium/icon.html.twig', { name: 'search', class: 'h-4 w-4' }) }}
            </span>
            <input
                type="search"
                name="search"
                value="{{ search }}"
                data-model="debounce(300)|search"
                placeholder="Search {{ this.resourceLabel|lower }}…"
                autocomplete="off"
                class="w-full rounded-lg border border-gray-300 py-2 pl-9 pr-3 text-sm shadow-sm transition-colors focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100"
            >
        </div>
        <span data-loading class="inline-flex items-center gap-1.5 text-sm text-gray-400">
            <svg class="h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z"></path>
            </svg>
        </span>
        {% if this.hasHeaderActions %}
            <div class="ml-auto">
                {{ include('@Atrium/components/actions.html.twig', { actions: this.headerActionViews }) }}
            </div>
        {% endif %}
    </div>

    {% if this.hasBulkActions and this.hasSelection %}
        <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-lg border border-primary-200 bg-primary-50 px-4 py-2.5 text-sm dark:border-primary-900 dark:bg-primary-950/40">
            <span class="font-medium text-primary-800 dark:text-primary-200">{{ this.selectedCount }} selected</span>
            {% if this.canSelectAllMatching %}
                <button type="button" data-action="live#action" data-live-action-param="selectAllMatching"
                        class="font-medium text-primary-700 underline-offset-2 hover:underline dark:text-primary-300">
                    Select all {{ this.totalCount }}
                </button>
            {% elseif this.selectAllActive %}
                <span class="text-primary-700 dark:text-primary-300">All {{ this.totalCount }} matching selected</span>
            {% endif %}
            <button type="button" data-action="live#action" data-live-action-param="clearSelection"
                    class="text-gray-500 transition-colors hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                Clear
            </button>
            <span class="ml-auto">
                {{ include('@Atrium/components/actions.html.twig', { actions: this.bulkActionViews, liveAction: 'requestBulkAction' }) }}
            </span>
        </div>
    {% endif %}

    <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-800">
            <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr>
                    {% if this.hasBulkActions %}
                        <th scope="col" class="w-10 px-4 py-3">
                            <input
                                type="checkbox"
                                aria-label="Select all on this page"
                                data-action="change->live#action"
                                data-live-action-param="togglePage"
                                {{ this.pageFullySelected ? 'checked' : '' }}
                                class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-900"
                            >
                        </th>
                    {% endif %}
                    {% for column in this.columns %}
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                            {% if column.isSortable() %}
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="sort"
                                    data-live-field-param="{{ column.getName() }}"
                                    class="group inline-flex items-center gap-1 uppercase tracking-wider transition-colors hover:text-gray-900 dark:hover:text-white"
                                >
                                    {{ column.getLabel() }}
                                    {% if sortField == column.getName() %}
                                        <span class="text-primary-500" aria-hidden="true">{{ sortDirection == 'desc' ? '↓' : '↑' }}</span>
                                    {% else %}
                                        <span class="text-gray-300 opacity-0 transition-opacity group-hover:opacity-100 dark:text-gray-600" aria-hidden="true">↕</span>
                                    {% endif %}
                                </button>
                            {% else %}
                                {{ column.getLabel() }}
                            {% endif %}
                        </th>
                    {% endfor %}
                    {% if this.hasRecordActions %}
                        <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                            <span class="sr-only">Actions</span>
                        </th>
                    {% endif %}
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white dark:divide-gray-800 dark:bg-gray-900">
                {% for row in this.rows %}
                    <tr class="transition-colors hover:bg-gray-50/80 dark:hover:bg-gray-800/40 {{ row.selected ? 'bg-primary-50/40 dark:bg-primary-950/20' : '' }}">
                        {% if this.hasBulkActions %}
                            <td class="px-4 py-3">
                                <input
                                    type="checkbox"
                                    aria-label="Select row"
                                    data-action="change->live#action"
                                    data-live-action-param="toggleRecord"
                                    data-live-id-param="{{ row.id }}"
                                    {{ row.selected ? 'checked' : '' }}
                                    class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-900"
                                >
                            </td>
                        {% endif %}
                        {% for cell in row.cells %}
                            <td class="whitespace-nowrap px-4 py-3 text-gray-700 first:font-medium first:text-gray-900 dark:text-gray-300 dark:first:text-gray-100">{{ cell }}</td>
                        {% endfor %}
                        {% if this.hasRecordActions %}
                            <td class="whitespace-nowrap px-4 py-3 text-right">
                                {{ include('@Atrium/components/actions.html.twig', { actions: row.actions }) }}
                            </td>
                        {% endif %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ this.columns|length + (this.hasRecordActions ? 1 : 0) + (this.hasBulkActions ? 1 : 0) }}" class="px-4 py-12 text-center text-sm text-gray-500 dark:text-gray-400">
                            No {{ this.resourceLabel|lower }} found.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% set pageCount = this.pageCount %}
    <div class="mt-4 flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
        <span>{{ this.totalCount }} result{{ this.totalCount == 1 ? '' : 's' }}</span>
        <div class="inline-flex items-center gap-3">
            <span class="tabular-nums">Page {{ page }} of {{ pageCount }}</span>
            <div class="inline-flex items-center gap-1">
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="gotoPage"
                    data-live-page-param="{{ page - 1 }}"
                    {{ page <= 1 ? 'disabled' : '' }}
                    aria-label="Previous page"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-gray-300 text-gray-500 transition-colors hover:bg-gray-50 hover:text-gray-900 disabled:cursor-not-allowed disabled:opacity-40 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                >
                    <span class="rotate-180">{{ include('@Atrium/icon.html.twig', { name: 'chevron-right', class: 'h-4 w-4' }) }}</span>
                </button>
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="gotoPage"
                    data-live-page-param="{{ page + 1 }}"
                    {{ page >= pageCount ? 'disabled' : '' }}
                    aria-label="Next page"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-gray-300 text-gray-500 transition-colors hover:bg-gray-50 hover:text-gray-900 disabled:cursor-not-allowed disabled:opacity-40 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                >
                    {{ include('@Atrium/icon.html.twig', { name: 'chevron-right', class: 'h-4 w-4' }) }}
                </button>
            </div>
        </div>
    </div>

    {% if this.isConfirming %}
        {{ include('@Atrium/components/confirm_modal.html.twig', {
            title: this.confirmingLabel,
            message: this.confirmingMessage,
            color: this.confirmingColor,
            confirmAction: 'confirmAction',
            cancelAction: 'cancelAction',
        }) }}
    {% elseif this.isConfirmingBulk %}
        {{ include('@Atrium/components/confirm_modal.html.twig', {
            title: this.confirmingBulkLabel,
            message: this.confirmingBulkMessage,
            color: this.confirmingBulkColor,
            confirmAction: 'confirmBulkAction',
            cancelAction: 'cancelBulkAction',
        }) }}
    {% endif %}
</div>
