<div {{ attributes }} class="atrium-datatable">
    <div class="mb-4 flex items-center gap-3">
        <div class="relative w-full max-w-sm">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                {{ include('@Atrium/icon.html.twig', { name: 'search', class: 'h-4 w-4' }) }}
            </span>
            <input
                type="search"
                name="search"
                value="{{ search }}"
                data-model="debounce(300)|search"
                placeholder="Search {{ this.resourceLabel|lower }}…"
                autocomplete="off"
                class="w-full rounded-lg border border-gray-300 py-2 pl-9 pr-3 text-sm shadow-sm transition-colors focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100"
            >
        </div>
        <span data-loading class="inline-flex items-center gap-1.5 text-sm text-gray-400">
            <svg class="h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z"></path>
            </svg>
        </span>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-800">
            <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr>
                    {% for column in this.columns %}
                        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                            {% if column.isSortable() %}
                                <button
                                    type="button"
                                    data-action="live#action"
                                    data-live-action-param="sort"
                                    data-live-field-param="{{ column.getName() }}"
                                    class="group inline-flex items-center gap-1 uppercase tracking-wider transition-colors hover:text-gray-900 dark:hover:text-white"
                                >
                                    {{ column.getLabel() }}
                                    {% if sortField == column.getName() %}
                                        <span class="text-primary-500" aria-hidden="true">{{ sortDirection == 'desc' ? '↓' : '↑' }}</span>
                                    {% else %}
                                        <span class="text-gray-300 opacity-0 transition-opacity group-hover:opacity-100 dark:text-gray-600" aria-hidden="true">↕</span>
                                    {% endif %}
                                </button>
                            {% else %}
                                {{ column.getLabel() }}
                            {% endif %}
                        </th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white dark:divide-gray-800 dark:bg-gray-900">
                {% for row in this.rows %}
                    <tr class="transition-colors hover:bg-gray-50/80 dark:hover:bg-gray-800/40">
                        {% for cell in row.cells %}
                            <td class="whitespace-nowrap px-4 py-3 text-gray-700 first:font-medium first:text-gray-900 dark:text-gray-300 dark:first:text-gray-100">{{ cell }}</td>
                        {% endfor %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ this.columns|length }}" class="px-4 py-12 text-center text-sm text-gray-500 dark:text-gray-400">
                            No {{ this.resourceLabel|lower }} found.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% set pageCount = this.pageCount %}
    <div class="mt-4 flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
        <span>{{ this.totalCount }} result{{ this.totalCount == 1 ? '' : 's' }}</span>
        <div class="inline-flex items-center gap-3">
            <span class="tabular-nums">Page {{ page }} of {{ pageCount }}</span>
            <div class="inline-flex items-center gap-1">
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="gotoPage"
                    data-live-page-param="{{ page - 1 }}"
                    {{ page <= 1 ? 'disabled' : '' }}
                    aria-label="Previous page"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-gray-300 text-gray-500 transition-colors hover:bg-gray-50 hover:text-gray-900 disabled:cursor-not-allowed disabled:opacity-40 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                >
                    <span class="rotate-180">{{ include('@Atrium/icon.html.twig', { name: 'chevron-right', class: 'h-4 w-4' }) }}</span>
                </button>
                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="gotoPage"
                    data-live-page-param="{{ page + 1 }}"
                    {{ page >= pageCount ? 'disabled' : '' }}
                    aria-label="Next page"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-gray-300 text-gray-500 transition-colors hover:bg-gray-50 hover:text-gray-900 disabled:cursor-not-allowed disabled:opacity-40 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                >
                    {{ include('@Atrium/icon.html.twig', { name: 'chevron-right', class: 'h-4 w-4' }) }}
                </button>
            </div>
        </div>
    </div>
</div>
