<div {{ attributes }} class="atrium-form">
    {% if this.hasHeaderActions and not this.embedded %}
        <div class="mb-5 flex flex-wrap items-center justify-end gap-2">
            {{ include('@Atrium/components/actions.html.twig', { actions: this.headerActionViews }) }}
        </div>
    {% endif %}

    <form data-action="live#action:prevent" data-live-action-param="save" novalidate class="space-y-5">
        {{ include('@Atrium/components/layout/components.html.twig', { components: this.components }) }}

        <div class="flex items-center gap-3 pt-1">
            <button type="button" data-action="live#action" data-live-action-param="save"
                    class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-primary-600/20 transition-colors hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950">
                {{ this.isEdit() ? 'Save changes' : 'Create' }}
            </button>
            {% if this.embedded %}
                <button type="button" data-action="live#action" data-live-action-param="cancelForm"
                        class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">
                    Cancel
                </button>
            {% endif %}
            <span data-loading class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">
                <svg class="h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z"></path>
                </svg>
                Saving…
            </span>
        </div>
    </form>

    {% if this.isConfirming %}
        {{ include('@Atrium/components/confirm_modal.html.twig', {
            title: this.confirmingLabel,
            message: this.confirmingMessage,
            color: this.confirmingColor,
            confirmAction: 'confirmAction',
            cancelAction: 'cancelAction',
        }) }}
    {% endif %}
</div>
