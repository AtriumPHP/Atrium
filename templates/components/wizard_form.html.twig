{#
    Host template for WizardForm (SCH-10). Same hydrate/validate/save core as
    form.html.twig, but the Wizard renders its own Next / Back / Submit footer —
    so there is no global submit button here.
#}
<div {{ attributes }} class="atrium-form">
    {% if this.hasHeaderActions %}
        <div class="mb-5 flex flex-wrap items-center justify-end gap-2">
            {{ include('@Atrium/components/actions.html.twig', { actions: this.headerActionViews }) }}
        </div>
    {% endif %}

    <form data-action="live#action:prevent" data-live-action-param="save" novalidate class="space-y-5">
        {{ include('@Atrium/components/layout/components.html.twig', { components: this.components }) }}
    </form>

    {% if this.isConfirming %}
        {{ include('@Atrium/components/confirm_modal.html.twig', {
            title: this.confirmingLabel,
            message: this.confirmingMessage,
            color: this.confirmingColor,
            confirmAction: 'confirmAction',
            cancelAction: 'cancelAction',
        }) }}
    {% endif %}
</div>
