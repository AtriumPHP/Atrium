{#
    Host template for WizardForm (SCH-10). Same hydrate/validate/save core as
    form.html.twig, but the Wizard renders its own Next / Back / Submit footer —
    so there is no global submit button here.
#}
<div {{ attributes }} class="atrium-form">
    {% if saved %}
        <div role="status" class="mb-5 flex items-center gap-2 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800 dark:border-green-900 dark:bg-green-950 dark:text-green-300">
            <svg class="h-5 w-5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            {{ this.resourceLabel }} saved successfully.
        </div>
    {% endif %}

    <form data-action="live#action:prevent" data-live-action-param="save" novalidate class="space-y-5">
        {{ include('@Atrium/components/layout/components.html.twig', { components: this.components }) }}
    </form>
</div>
